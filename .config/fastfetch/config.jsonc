{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
  "source": "~/.config/fastfetch/arch.png",
  "type": "kitty-direct",
  "height": 10,
  "width": 20,
  "padding": {
    "top": 1
    }
  },
    "display": {
        "separator": " -> "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "   \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[90m "
        },
        {
            "type": "title",
            "keyWidth": 10,
			"format": "      {6}{7}{8}"
        },
        {
            "type": "command",
            "key": " ",
            "keyColor": "magenta",
            "text": "echo Estamos há $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) dias neste GNU Linux"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": " ",
            "keyColor": "blue",
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": "󰢮 ",
            "keyColor": "blue",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "yellow",
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "green",
            // format: used / total
            "format": "{1} / {2}"
        },
        {
            "type": "swap",
            "key": "󰓡 ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "red",
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "31"
        },
        {
            "type": "uptime",
            "key": "󰔛 ",
            "keyColor": "36"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── ",
            "keyColor": "90"
        },
        {
            "type": "custom",
            "format": "   \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[90m "
        },
		"break",
    ]
}
