animations {
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=500 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=0.8 stiffness=500 epsilon=0.0001
    }
    window-open {
        duration-ms 600
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 300
        curve "ease-out-quad"
    }
}
