// https://niri-wm.github.io/niri/Configuration:-Outputs
// `niri msg outputs`

output "eDP-1" {
    // off
    // "<width>x<height>" or "<width>x<height>@<refresh_rate>"
    mode "1920x1080@60.010"
    scale 1.25
    transform "normal" // normal, 90, flipped, flipped-90, etc
    position x=1920 y=0
}
output "HDMI-A-2" {
    // comment out below to extend the external monitor to the right
    position x=0 y=0
}
